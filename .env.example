# Copy this file to .env and fill in real values.
# .env is gitignored — this example file is safe to commit.
# Add a line here whenever a tool needs a new key, so the required config stays documented.

# Twitch app (free): https://dev.twitch.tv/console/apps -> Register Your Application
#   OAuth Redirect URL: https://localhost   Category: Application Integration   Client Type: Confidential
#   (The redirect URL isn't used by the clip fetcher; Twitch just requires an HTTPS one to register the app.)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Anthropic API (Shorts titles via Claude Haiku 5.5, ~$0.0005/title): https://console.anthropic.com -> API Keys
# Optional: without it, titles fall back to the rule-based version.
ANTHROPIC_API_KEY=

# Google OAuth: credentials.json / token.json live in the project root (gitignored).
# Override the paths here only if you keep them somewhere else.
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
# YOUTUBE_TOKEN_FILE=token_youtube.json
